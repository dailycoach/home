{
  "templateId": "dailycoaching.contract.business.v1",
  "templateVersion": "1.0.0",
  "locale": "ko-KR",
  "title": "DAILYCOACHING 비즈니스 코칭계약",
  "status": "DRAFT_FOR_LEGAL_REVIEW",
  "contractType": "business",
  "extends": {
    "templateId": "dailycoaching.contract.common.v1",
    "file": "common.v1.json",
    "includeAllCommonClauses": true,
    "includeAllOptionalConsents": true
  },
  "audience": {
    "adultsOnly": true,
    "minimumAge": 19,
    "minorUseBlocked": true,
    "adultAffirmationRequired": true,
    "failureAction": "BLOCK_CONTRACT_CREATION",
    "notice": "본 계약은 성인 고객을 위한 v1 계약입니다. 미성년 고객 또는 학생 대상 기관 계약에는 사용하지 않습니다."
  },
  "overview": {
    "appropriateFor": [
      "리더십, 역할, 의사결정과 실행을 다루는 성인 고객",
      "조직 안에서 합의한 목표를 중심으로 코칭을 받는 임직원",
      "고객 외에 비용 지급자 또는 조직 스폰서가 참여하는 코칭",
      "보고 범위와 비밀보장 경계를 사전에 분명히 해야 하는 조직 코칭"
    ],
    "contractModes": [
      {
        "id": "direct_two_party",
        "label": "2자 계약",
        "description": "코치와 실제 코칭 고객이 계약하며 고객이 비용과 계약 책임을 직접 부담합니다."
      },
      {
        "id": "sponsored_three_party",
        "label": "3자 계약",
        "description": "코치, 실제 코칭 고객, 비용 지급자 또는 조직 스폰서가 참여하며 역할·보고·종료 권한을 별도로 합의합니다."
      }
    ],
    "noGuarantees": ["조직 성과", "매출", "승진", "인사평가", "리더십 평가", "기타 경영 결과"]
  },
  "parties": [
    {
      "role": "coach",
      "label": "코치",
      "required": true,
      "requiredSigner": true,
      "responsibilities": ["합의된 코칭 제공", "역할·비밀보장·보고 경계 설명", "이해충돌 관리", "기록과 정보의 최소 처리"]
    },
    {
      "role": "client",
      "label": "실제 코칭 고객",
      "required": true,
      "requiredSigner": true,
      "responsibilities": ["코칭 목표와 의제에 대한 자기결정", "공유 범위 사전 확인", "추가 공유 내용의 직접 승인", "변경·종료 요청"]
    },
    {
      "role": "sponsor",
      "label": "비용 지급자 또는 조직 스폰서",
      "requiredWhen": "contract_mode === 'sponsored_three_party'",
      "requiredSignerWhen": "contract_mode === 'sponsored_three_party'",
      "responsibilities": ["비용·행정 조건 이행", "합의된 보고 범위 준수", "세션 원문·노트·개인 발언 비공개 원칙 준수", "합의된 범위의 종료 권한 행사"]
    },
    {
      "role": "organization_contact",
      "label": "조직 계약 담당자",
      "requiredWhen": "organization_contact_is_distinct === true",
      "requiredSigner": false,
      "responsibilities": ["계약 행정 연락", "권한 범위 내 정보 수령", "비밀정보의 추가 배포 금지"]
    }
  ],
  "requiredBusinessSettings": [
    {
      "key": "payer",
      "label": "비용 지급자",
      "required": true
    },
    {
      "key": "contract_owner",
      "label": "계약 책임자",
      "required": true
    },
    {
      "key": "session_participant",
      "label": "세션 참여자",
      "required": true,
      "mustIncludeRole": "client"
    },
    {
      "key": "report_recipient",
      "label": "보고 수신자",
      "required": true,
      "allowNone": true
    },
    {
      "key": "report_frequency",
      "label": "보고 주기",
      "required": true,
      "allowNone": true
    },
    {
      "key": "shareable_information",
      "label": "공유 가능한 정보",
      "required": true,
      "defaultValue": ["attendance", "contract_progress_status"]
    },
    {
      "key": "prohibited_information",
      "label": "공유 금지 정보",
      "required": true,
      "lockedMinimumValues": ["session_transcript", "session_notes", "client_personal_statements"]
    },
    {
      "key": "termination_authority",
      "label": "계약 종료 권한",
      "required": true
    },
    {
      "key": "conflict_resolution_method",
      "label": "이해충돌 처리 방식",
      "required": true
    }
  ],
  "reportingPolicy": {
    "defaultScope": {
      "id": "attendance_and_status_only",
      "label": "출석·진행 여부만",
      "allowedFields": ["attendance", "contract_progress_status"]
    },
    "defaultProhibited": [
      {
        "key": "session_transcript",
        "label": "세션 원문 공유 금지"
      },
      {
        "key": "session_notes",
        "label": "세션 노트 공유 금지"
      },
      {
        "key": "client_personal_statements",
        "label": "고객의 개인적 발언 공유 금지"
      }
    ],
    "scopeOptions": [
      {
        "id": "attendance_and_status_only",
        "label": "출석·진행 여부만",
        "requiresClientAdvanceConfirmation": false
      },
      {
        "id": "agreed_goals_and_progress_summary",
        "label": "합의된 목표와 진행 요약",
        "requiresClientAdvanceConfirmation": true,
        "sessionContentExcluded": true
      },
      {
        "id": "client_directly_approved_content",
        "label": "고객이 직접 승인한 내용",
        "requiresClientPerDisclosureApproval": true
      },
      {
        "id": "specified_items",
        "label": "별도 기재한 특정 항목",
        "requiresWrittenSpecification": true,
        "requiresClientAdvanceConfirmation": true
      }
    ],
    "additionalDisclosureRule": "기본 범위를 넘는 정보 공유가 필요한 경우 고객이 공개 전에 대상, 목적, 내용과 시점을 확인하고 직접 승인해야 한다.",
    "noImpliedAccessForPayer": true
  },
  "contractFieldRequirements": [
    {
      "field": "contract_mode",
      "label": "2자 또는 3자 계약 구조",
      "required": true,
      "allowedValues": ["direct_two_party", "sponsored_three_party"]
    },
    {
      "field": "goal_summary",
      "label": "합의된 코칭 목표",
      "required": true,
      "maxLength": 2000
    },
    {
      "field": "session_count_and_minutes",
      "label": "회기 수와 회기 시간",
      "required": true
    },
    {
      "field": "contract_period",
      "label": "계약 기간",
      "required": true
    },
    {
      "field": "fee_and_payment_terms",
      "label": "비용과 지급 방식",
      "required": true,
      "reviewStatus": "LEGAL_REVIEW_REQUIRED"
    },
    {
      "field": "cancellation_and_refund_terms",
      "label": "일정 변경·취소·환불 기준",
      "required": true,
      "autoGenerateProhibited": true,
      "reviewStatus": "LEGAL_REVIEW_REQUIRED"
    },
    {
      "field": "reporting_scope",
      "label": "보고 범위",
      "required": true,
      "defaultValue": "attendance_and_status_only"
    }
  ],
  "clauses": [
    {
      "order": 101,
      "id": "business.party_structure",
      "title": "비즈니스 코칭 당사자 구조",
      "summary": "코치, 실제 코칭 고객과 해당되는 경우 스폰서의 역할을 분리합니다.",
      "body": "본 계약은 {{contract_mode}} 구조로 진행합니다. 실제 세션 참여자와 코칭 의제의 주체는 {{client_name}}이며, 비용 지급자 {{payer_name}}, 계약 책임자 {{contract_owner_name}}, 보고 수신자 {{report_recipient_name}}의 역할과 권한은 서로 동일하다고 추정하지 않고 계약서에 개별 표시합니다. 스폰서가 있는 경우 스폰서는 합의된 행정·보고 범위를 준수하며 고객의 세션 내용에 대한 포괄적 접근 권한을 갖지 않습니다.",
      "reviewStatus": "CONTENT_READY",
      "required": true,
      "variables": ["{{contract_mode}}", "{{client_name}}", "{{payer_name}}", "{{contract_owner_name}}", "{{report_recipient_name}}"]
    },
    {
      "order": 102,
      "id": "business.shared_goals",
      "title": "조직 목표와 고객의 코칭 목표",
      "summary": "스폰서가 제시한 기대와 고객이 선택한 실제 코칭 목표의 관계를 명확히 합니다.",
      "body": "스폰서 또는 조직이 제시한 기대는 {{organization_goal_summary}}이고 고객과 코치가 합의한 코칭 목표는 {{goal_summary}}입니다. 두 목표가 다르거나 고객의 자기결정권·비밀보장과 충돌하면 코치는 고객과 스폰서가 경계를 다시 확인하도록 돕습니다. 고객의 개인적 의제를 조직 보고용 목표로 자동 전환하지 않습니다.",
      "reviewStatus": "CONTENT_READY",
      "required": true,
      "variables": ["{{organization_goal_summary}}", "{{goal_summary}}"]
    },
    {
      "order": 103,
      "id": "business.reporting_and_confidentiality",
      "title": "보고 범위와 세션 비밀보장",
      "summary": "기본 공유는 출석·계약 진행 상태로 제한하고 세션 원문·노트·개인 발언은 공유하지 않습니다.",
      "body": "기본 보고 범위는 출석 여부와 계약 진행 상태입니다. 세션 원문, 세션 노트 및 고객의 개인적 발언은 스폰서·비용 지급자·조직 담당자에게 공유하지 않습니다. 선택된 보고 범위가 {{reporting_scope}}인 경우에도 공유 대상, 목적, 주기와 항목을 사전에 특정하며, 기본 범위를 넘는 내용은 고객이 공개 전에 직접 확인하고 승인한 범위로 제한합니다.",
      "reviewStatus": "CONTENT_READY",
      "required": true,
      "variables": ["{{reporting_scope}}"]
    },
    {
      "order": 104,
      "id": "business.sponsor_rights_and_limits",
      "title": "스폰서의 권리와 한계",
      "summary": "스폰서는 합의된 비용·보고·종료 권한만 행사하며 세션 내용을 통제하지 않습니다.",
      "body": "스폰서는 {{sponsor_payment_terms}}에 따라 비용을 부담하고 {{sponsor_reporting_terms}}의 정보를 수령하며 {{sponsor_termination_authority}}의 범위에서 계약 종료를 요청할 수 있습니다. 비용 지급 사실만으로 세션 의제를 지시하거나 세션 원문·노트·고객의 개인적 발언을 요구할 권리가 발생하지 않습니다. 스폰서 요청과 고객의 권리가 충돌하면 코치는 이해충돌을 알리고 조정·범위 축소·계약 종료를 포함한 대응을 협의합니다.",
      "reviewStatus": "LEGAL_REVIEW_REQUIRED",
      "required": true,
      "variables": ["{{sponsor_payment_terms}}", "{{sponsor_reporting_terms}}", "{{sponsor_termination_authority}}"]
    },
    {
      "order": 105,
      "id": "business.conflicts",
      "title": "조직 내 이해충돌",
      "summary": "평가·인사·보고 역할과 코칭 역할이 충돌할 가능성을 사전에 확인합니다.",
      "body": "코치가 조직의 평가, 교육, 컨설팅, 자문 또는 다른 역할을 함께 수행하거나 보고 수신자가 고객의 인사평가 권한을 갖는 경우 실제·잠재적 이해충돌을 계약 전에 확인합니다. 코치는 역할별 목적과 정보 경계를 설명하고 {{conflict_resolution_method}}에 따라 회피, 역할 분리, 정보 제한, 별도 동의 또는 종료 방안을 적용합니다.",
      "reviewStatus": "CONTENT_READY",
      "required": true,
      "variables": ["{{conflict_resolution_method}}"]
    },
    {
      "order": 106,
      "id": "business.no_performance_guarantee",
      "title": "조직·경영 결과의 비보장",
      "summary": "매출, 승진, 평가와 조직 성과를 보장하지 않습니다.",
      "body": "비즈니스 코칭은 고객의 리더십, 역할, 의사결정과 실행에 대한 성찰을 지원하지만 매출, 조직 성과, 승진, 인사평가, 성과등급 또는 특정 경영 결과를 보장하지 않습니다. 비보장 조항은 코치가 계약된 서비스를 성실히 제공하고 스폰서와 고객의 합의를 준수할 책임을 면제하지 않습니다.",
      "reviewStatus": "CONTENT_READY",
      "required": true,
      "variables": []
    },
    {
      "order": 107,
      "id": "business.termination",
      "title": "고객·스폰서의 종료 권한",
      "summary": "고객과 스폰서의 종료 권한, 통지 방식과 비용·정보 후속 처리를 구분합니다.",
      "body": "고객은 코칭 참여와 계약 종료를 요청할 수 있고, 스폰서는 {{sponsor_termination_authority}}에 명시된 범위에서 계약 종료를 요청할 수 있습니다. 어느 한 당사자의 종료가 다른 당사자의 비용·보고·기록 권리에 미치는 영향은 {{business_termination_terms}}에 따르며, 종료 시에도 합의한 비밀보장과 공유 금지 의무는 유지됩니다. 모든 필수 서명자가 서명하기 전에는 계약을 fully_signed로 처리하지 않습니다.",
      "reviewStatus": "LEGAL_REVIEW_REQUIRED",
      "required": true,
      "variables": ["{{sponsor_termination_authority}}", "{{business_termination_terms}}"]
    }
  ],
  "signingRules": {
    "requiredSignerRolesByMode": {
      "direct_two_party": ["coach", "client"],
      "sponsored_three_party": ["coach", "client", "sponsor"]
    },
    "fullySignedWhenAllRequiredSignersComplete": true,
    "completionBlockedUntilAllRequiredSignersComplete": true,
    "proxySignatureProhibited": true,
    "coachMayNotSignForClientOrSponsor": true
  },
  "consentRules": {
    "source": "common.v1.json#/optionalConsents",
    "keys": ["session_recording", "ai_assisted_summary", "anonymized_case_use", "marketing_testimonial"],
    "independentSelections": true,
    "defaultAccepted": false,
    "bulkAcceptProhibited": true,
    "serviceAvailableWhenDeclined": true,
    "sponsorCannotConsentForClient": true,
    "aiDisabledUntilAllConfigurationPresent": true,
    "marketingSubSelections": ["disclose_name", "disclose_photo", "disclose_organization", "disclose_testimonial_text", "publication_channels", "publication_period"]
  },
  "legalReviewItems": [
    "2자·3자 계약에서 각 당사자의 비용·종료·손해 책임",
    "조직 스폰서 보고 범위와 개인정보 제공·처리 근거",
    "고객과 스폰서의 종료 권한 및 환불 산정",
    "인사평가 권한자와 코칭 정보 사이의 이해충돌 처리",
    "개인정보와 조직 기록의 보유기간·처리위탁·국외 이전",
    "전자서명 증빙 수준 및 분쟁 조항",
    "실제 사용하는 녹음·AI·외부 기술 서비스 문구"
  ]
}
