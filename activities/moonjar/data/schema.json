{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonjar Web Project v1",
  "description": "웹앱 구현용 데이터 계약 초안. 앱 구현 또는 실행 완료를 뜻하지 않습니다. 좌표는 1600x1800 논리 캔버스 기준이고 x/y는 조각 중심입니다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "dailycoaching.moonjar.project"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contentVersion": {
      "const": "story-v3-web-v1.0.0"
    },
    "assetPackVersion": {
      "const": "moonjar-png-v3"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "guided",
        "free"
      ]
    },
    "currentScene": {
      "enum": [
        "arrival",
        "vessel",
        "nacre",
        "arrange",
        "reframe",
        "name",
        "return",
        "ending"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "pieceNotes": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "memory": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "label",
          "memory"
        ]
      }
    },
    "reflections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrival": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bodySignal": {
              "type": "string",
              "maxLength": 2000
            },
            "currentWord": {
              "type": "string",
              "maxLength": 2000
            },
            "intention": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "bodySignal",
            "currentWord",
            "intention"
          ]
        },
        "vessel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "firstMind": {
              "type": "string",
              "maxLength": 200
            },
            "secondMind": {
              "type": "string",
              "maxLength": 200
            },
            "whatTheySay": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "firstMind",
            "secondMind",
            "whatTheySay"
          ]
        },
        "nacre": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selectedLightNote": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "selectedLightNote"
          ]
        },
        "arrange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "easyMoment": {
              "type": "string",
              "maxLength": 2000
            },
            "hesitantMoment": {
              "type": "string",
              "maxLength": 2000
            },
            "importantToMe": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "easyMoment",
            "hesitantMoment",
            "importantToMe"
          ]
        },
        "reframe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed": {
              "type": "string",
              "maxLength": 2000
            },
            "interpretation": {
              "type": "string",
              "maxLength": 2000
            },
            "wantToExplore": {
              "type": "string",
              "maxLength": 2000
            },
            "changed": {
              "type": "string",
              "maxLength": 2000
            },
            "kept": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "observed",
            "interpretation",
            "wantToExplore",
            "changed",
            "kept"
          ]
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "noticed": {
              "type": "string",
              "maxLength": 2000
            },
            "keySentence": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "noticed",
            "keySentence"
          ]
        },
        "return": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "noticed": {
              "type": "string",
              "maxLength": 2000
            },
            "situation": {
              "type": "string",
              "maxLength": 2000
            },
            "action": {
              "type": "string",
              "maxLength": 2000
            },
            "support": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "noticed",
            "situation",
            "action",
            "support"
          ]
        },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "presentWord": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "presentWord"
          ]
        }
      },
      "required": [
        "arrival",
        "vessel",
        "nacre",
        "arrange",
        "reframe",
        "name",
        "return",
        "ending"
      ]
    },
    "snapshots": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "contentVersion",
    "assetPackVersion",
    "projectId",
    "revision",
    "createdAt",
    "updatedAt",
    "mode",
    "currentScene",
    "title",
    "scene",
    "pieceNotes",
    "reflections",
    "snapshots"
  ],
  "$defs": {
    "pieceNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,80}$"
        },
        "kind": {
          "const": "piece"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-H](0[1-9]|1[0-2])$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1600
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1800
        },
        "width": {
          "type": "number",
          "minimum": 16,
          "maximum": 1600
        },
        "height": {
          "type": "number",
          "minimum": 16,
          "maximum": 1800
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "instanceId",
        "kind",
        "assetId",
        "x",
        "y",
        "width",
        "height",
        "rotation",
        "locked"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateId": {
          "const": "outline-v3"
        },
        "width": {
          "const": 1600
        },
        "height": {
          "const": 1800
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "placementMode": {
          "const": "free"
        },
        "nodes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/pieceNode"
          }
        }
      },
      "required": [
        "templateId",
        "width",
        "height",
        "theme",
        "placementMode",
        "nodes"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,80}$"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "scene": {
          "$ref": "#/$defs/scene"
        }
      },
      "required": [
        "id",
        "label",
        "createdAt",
        "scene"
      ]
    }
  }
}
