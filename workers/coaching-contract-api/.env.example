# Copy to .dev.vars for local development. Never commit .dev.vars.
# Generate independent 32-byte values; do not reuse keys between development
# and production. Example generator: openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
TOKEN_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
OTP_HASH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
AUDIT_HASH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES

# Cloudflare Access application values for /v1/admin/*.
CF_ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM.cloudflareaccess.com
ADMIN_ACCESS_AUDIENCE=REPLACE_WITH_ACCESS_APPLICATION_AUD

ALLOWED_ORIGIN=https://daily-coach-ing.com
DATA_ENCRYPTION_KEY_VERSION=v1

# These are deliberate deployment blockers, not sample operating values.
LEGAL_REVIEW_STATUS=LEGAL_REVIEW_REQUIRED
LEGAL_REVIEW_REFERENCE=LEGAL_REVIEW_REQUIRED
CONTRACT_RETENTION_POLICY=LEGAL_REVIEW_REQUIRED
PROCESSOR_AND_TRANSFER_POLICY=LEGAL_REVIEW_REQUIRED
DISPUTE_AND_REFUND_POLICY=LEGAL_REVIEW_REQUIRED
APPROVED_TEMPLATE_MANIFESTS=LEGAL_REVIEW_REQUIRED
APPROVED_CONTRACT_POLICY_JSON=LEGAL_REVIEW_REQUIRED

INVITE_TTL_SECONDS=604800
INVITE_SESSION_TTL_SECONDS=1800
FINAL_ACCESS_TTL_SECONDS=604800
FINAL_DOCUMENT_SESSION_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5

# Optional delivery integration. No provider is selected in v1.
MAIL_API_KEY=
MAIL_FROM=
